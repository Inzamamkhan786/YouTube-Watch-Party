// Prisma Schema for YouTube Watch Party (YouTube Parity)
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum RoomRole {
  HOST
  MODERATOR
  PARTICIPANT
  VIEWER
}

enum RequestType {
  REQUEST_PLAY
  REQUEST_PAUSE
  REQUEST_SEEK
  REQUEST_CHANGE_VIDEO
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String
  displayName      String?
  avatarUrl        String?
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  hostedRooms          Room[]          @relation("RoomHost")
  roomMemberships      RoomMember[]
  messages             Message[]
  reactions            Reaction[]
  actionRequests       ActionRequest[] @relation("UserActionRequests")
  reviewedRequests     ActionRequest[] @relation("ReviewedActionRequests")
  authTokens           AuthToken[]

  @@index([email])
  @@map("users")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([type, expiresAt])
  @@map("auth_tokens")
}

model Room {
  id          String   @id @default(uuid())
  roomCode    String   @unique
  title       String
  description String?
  isPrivate   Boolean  @default(false)
  passcode    String?
  maxMembers  Int      @default(50)
  hostId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Authoritative YouTube playback state
  currentVideoId String?
  isPlaying      Boolean  @default(false)
  currentTime    Float    @default(0.0)
  stateUpdatedAt DateTime @default(now())

  // Relations
  host           User            @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members        RoomMember[]
  messages       Message[]
  reactions      Reaction[]
  actionRequests ActionRequest[]

  @@index([roomCode])
  @@index([hostId])
  @@map("rooms")
}

model RoomMember {
  id         String   @id @default(uuid())
  roomId     String
  userId     String
  role       RoomRole @default(PARTICIPANT)
  isMuted    Boolean  @default(false)
  isBanned   Boolean  @default(false)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per room
  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  content   String   @db.Text
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([roomId])
  @@index([userId])
  @@index([roomId, createdAt])
  @@map("messages")
}

model Reaction {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  messageId String?
  emoji     String
  videoTime Float    @default(0)
  createdAt DateTime @default(now())

  // Relations
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([messageId])
  @@map("reactions")
}

model ActionRequest {
  id           String       @id @default(uuid())
  roomId       String
  userId       String
  requestType  RequestType
  payload      Json?
  status       ActionStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User  @relation("UserActionRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedActionRequests", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([userId])
  @@index([roomId, status])
  @@map("action_requests")
}
